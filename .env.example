# Prázdné = produkční režim s konkrétní diagnostikou; demo se volí výslovně v UI.
VITE_DATA_MODE=
# Pouze veřejná konfigurace budoucího vlastního Firebase projektu (E3).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
# true pouze pro pnpm dev a projekt demo-mvhunt, adresy emulátorů jsou localhost.
VITE_USE_EMULATORS=false
# Volitelné vývojové porty pro izolované UI ověření; výchozí 9099/9000.
VITE_AUTH_EMULATOR_PORT=9099
VITE_DATABASE_EMULATOR_PORT=9000
# Ve vývoji prázdné = Vite proxy /api/lobby; produkce vyžaduje HTTPS API.
VITE_LOBBY_API_URL=
