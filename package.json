{
  "name": "mvhunt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lobby:server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.rules.json",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:server": "node --test tests/server.test.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "test:watch": "vitest src",
    "test:rules": "firebase emulators:exec --project demo-mvhunt --only database,auth \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-mvhunt --only database,auth",
    "test:rules:isolated": "firebase emulators:exec --config firebase.test.json --project demo-mvhunt --only database,auth \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/leaflet": "1.9.21",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.34.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
